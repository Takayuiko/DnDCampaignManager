{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=dndcampaignmanager;Username=dndadmin;Password=CHANGE_ME"
    },
    "Jwt": {
        "Issuer": "DnDCampaignManager",
        "Audience": "DnDCampaignManager"
    },
    "OpenAI": {
        "Limits": {
            "MaxContextCharacters": 48000,
            "MaxHistoryCharacters": 24000,
            "MaxRequestBytes": 256000,
            "MaxOutputTokens": 4096,
            "RequestTimeoutSeconds": 120,
            "EmbeddingTimeoutSeconds": 30,
            "TranscriptionTimeoutSeconds": 120,
            "MaxConcurrentRequests": 4,
            "MaxQueuedRequests": 8,
            "ConcurrencyWaitSeconds": 5
        },
        "Model": "gpt-5.2",
        "EmbeddingModel": "text-embedding-3-small",
        "EmbeddingDimensions": 512,
        "TranscriptionModel": "gpt-transcribe",
        "Pricing": {
            "gpt-5.2": {
                "InputPer1M": 1.75,
                "OutputPer1M": 14.0
            }
        }
    },
    "Rag": {
        "MinimumSimilarity": 0.25
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
